{
  "description": "Loads memory at session start, blocks secrets in memory writes and allows writes to the memory directory, flushes before compaction, syncs at session end.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Write|Edit|MultiEdit|Bash", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/memory-3layer\" guard", "timeout": 15 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.sh\"", "timeout": 15 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\"", "timeout": 15 } ] }
    ]
  }
}
